                <mxCell id="ic_note" value="Webhook / Polling фоновый (не блокирует запросы)" style="text;html=1;align=center;fontSize=9;fillColor=#fff3e0;strokeColor=#cc6600;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="1620" y="570" width="480" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="ic_note2" value="Новые СК подключаются без изменений core-app и ins-comp-settlement" style="text;html=1;align=center;fontSize=9;fillColor=#fff3e0;strokeColor=#cc6600;" parent="1" vertex="1">
                    <mxGeometry x="1620" y="600" width="480" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="system_boundary" value="InsureTech — Система (Kubernetes кластер)" style="html=1;strokeColor=#5282FF;fillColor=#f0f4ff;verticalAlign=top;fontSize=12;fontStyle=1;padding=10;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="200" y="220" width="1360" height="940" as="geometry"/>
                </mxCell>
                <mxCell id="api_gw" value="API Gateway / Nginx Ingress&#xa;&#xa;Маршрутизация входящих HTTP-запросов&#xa;от клиентов к core-app" style="rounded=1;fillColor=#5282FF;strokeColor=#3a60cc;fontColor=white;fontSize=10;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="350" y="270" width="220" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="core_app_box" value="core-app (контейнер)" style="html=1;strokeColor=#2e7d32;fillColor=#e8f5e9;verticalAlign=top;fontSize=11;fontStyle=1;padding=8;" parent="1" vertex="1">
                    <mxGeometry x="280" y="420" width="500" height="360" as="geometry"/>
                </mxCell>
                <mxCell id="core_app_svc" value="core-app&#xa;(Spring Boot / Node.js)&#xa;&#xa;• Оформление страховок&#xa;• Показ продуктов и тарифов&#xa;• Хранит локальную реплику&#xa;  продуктов (обновляется&#xa;  из Kafka-топика)&#xa;• Публикует PolicyIssued&#xa;  через Outbox-таблицу" style="rounded=1;fillColor=#4caf50;strokeColor=#2e7d32;fontColor=white;fontSize=10;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="300" y="450" width="220" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="outbox_table" value="Outbox-таблица&#xa;(PostgreSQL)&#xa;&#xa;[Transactional Outbox]&#xa;policy_events: id, type,&#xa;payload, published_at&#xa;&#xa;Запись атомарна с&#xa;основной транзакцией" style="shape=table;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=9;verticalAlign=top;align=left;spacingLeft=5;" parent="1" vertex="1">
                    <mxGeometry x="300" y="660" width="220" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="core_db" value="PostgreSQL&#xa;(core-app DB)&#xa;Страховки, клиенты,&#xa;реплика продуктов" style="shape=cylinder3;fillColor=#a5d6a7;strokeColor=#2e7d32;fontSize=9;verticalAlign=bottom;" parent="1" vertex="1">
                    <mxGeometry x="540" y="650" width="120" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="outbox_relay" value="Outbox Relay&#xa;(CDC / Debezium&#xa; или polling loop)&#xa;&#xa;Читает Outbox-таблицу&#xa;и публикует в Kafka" style="rounded=1;fillColor=#81c784;strokeColor=#2e7d32;fontSize=9;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="610" y="460" width="140" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="kafka_box" value="Apache Kafka (Message Broker)" style="html=1;strokeColor=#b71c1c;fillColor=#ffebee;verticalAlign=top;fontSize=11;fontStyle=1;padding=8;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="820" y="380" width="680" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="kafka_icon" value="Kafka" style="shape=mxgraph.logos.kafka;fillColor=#b71c1c;strokeColor=none;fontSize=10;fontColor=#b71c1c;verticalLabelPosition=bottom;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="840" y="400" width="50" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="topic_products" value="Топик: products.updated&#xa;&#xa;Событие: ProductUpdated&#xa;{ company_id, product_id,&#xa;  tariff, effective_from }&#xa;&#xa;Retention: 7 дней&#xa;Partitions: по company_id&#xa;&#xa;Producer: ins-product-aggregator&#xa;Consumers: core-app,&#xa;           ins-comp-settlement" style="rounded=1;fillColor=#ef9a9a;strokeColor=#b71c1c;fontSize=9;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="910" y="395" width="260" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="topic_policies" value="Топик: policies.issued&#xa;&#xa;Событие: PolicyIssued&#xa;{ policy_id, client_id,&#xa;  product_id, company_id,&#xa;  amount, issued_at }&#xa;&#xa;Retention: 30 дней&#xa;Partitions: по date&#xa;&#xa;Producer: core-app (Outbox)&#xa;Consumer: ins-comp-settlement" style="rounded=1;fillColor=#ef9a9a;strokeColor=#b71c1c;fontSize=9;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="1190" y="395" width="270" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="agg_box" value="ins-product-aggregator (контейнер)" style="html=1;strokeColor=#1565c0;fillColor=#e3f2fd;verticalAlign=top;fontSize=11;fontStyle=1;padding=8;" parent="1" vertex="1">
                    <mxGeometry x="830" y="720" width="450" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="agg_svc" value="ins-product-aggregator&#xa;(фоновый сервис)&#xa;&#xa;• Периодически опрашивает&#xa;  каждую СК (или получает&#xa;  webhook) в фоне&#xa;• НЕ обрабатывает входящие&#xa;  синхронные запросы&#xa;• При изменении данных&#xa;  публикует ProductUpdated&#xa;  в Kafka&#xa;• Circuit breaker на каждую СК&#xa;  — сбой одной не влияет&#xa;  на остальных" style="rounded=1;fillColor=#1976d2;strokeColor=#1565c0;fontColor=white;fontSize=10;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="850" y="755" width="240" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="agg_cache" value="Redis / in-memory cache&#xa;&#xa;Последний известный&#xa;снимок данных по каждой СК&#xa;(на случай временной&#xa;недоступности СК)" style="shape=cylinder3;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=9;verticalAlign=bottom;" parent="1" vertex="1">
                    <mxGeometry x="1110" y="755" width="140" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="settlement_box" value="ins-comp-settlement (контейнер)" style="html=1;strokeColor=#6a1b9a;fillColor=#f3e5f5;verticalAlign=top;fontSize=11;fontStyle=1;padding=8;" parent="1" vertex="1">
                    <mxGeometry x="280" y="820" width="500" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="settlement_svc" value="ins-comp-settlement&#xa;(Spring Boot / сервис расчётов)&#xa;&#xa;• Подписан на products.updated&#xa;  — обновляет локальную&#xa;  реплику продуктов&#xa;  (инкрементально)&#xa;• Подписан на policies.issued&#xa;  — накапливает реестр&#xa;  полисов в реальном времени&#xa;• Нет ночного батч-запроса&#xa;  к core-app и агрегатору" style="rounded=1;fillColor=#8e24aa;strokeColor=#6a1b9a;fontColor=white;fontSize=10;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="300" y="855" width="240" height="215" as="geometry"/>
                </mxCell>
                <mxCell id="settlement_db" value="PostgreSQL&#xa;(settlement DB)&#xa;Реестр полисов,&#xa;реплика продуктов,&#xa;расчёты" style="shape=cylinder3;fillColor=#ce93d8;strokeColor=#6a1b9a;fontSize=9;verticalAlign=bottom;" parent="1" vertex="1">
                    <mxGeometry x="560" y="870" width="130" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="e_user_gw" value="HTTPS / REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#5282FF;strokeWidth=2;fontSize=9;" parent="1" source="users_box" target="api_gw" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_gw_core" value="HTTP / REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#5282FF;strokeWidth=2;fontSize=9;" parent="1" source="api_gw" target="core_app_svc" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_core_db" value="SQL (JDBC)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2e7d32;fontSize=9;" parent="1" source="core_app_svc" target="core_db" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_core_outbox" value="атомарная&#xa;запись" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2e7d32;fontSize=9;dashed=1;" parent="1" source="core_app_svc" target="outbox_table" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
