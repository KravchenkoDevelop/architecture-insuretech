                <mxCell id="e_agg_ic" value="REST API / Webhook&#xa;(фоновый, с Circuit Breaker&#xa;на каждую СК независимо)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#cc6600;strokeWidth=2;fontSize=9;fontStyle=1;" parent="1" source="agg_svc" target="ic_box" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="eliminated_box" value="УСТРАНЁННЫЕ ВЗАИМОДЕЙСТВИЯ (было в AS-IS)" style="html=1;strokeColor=#cc0000;fillColor=#ffe6e6;verticalAlign=top;fontSize=10;fontStyle=1;dashed=1;padding=8;" parent="1" vertex="1">
                    <mxGeometry x="220" y="1140" width="1320" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="elim1" value="✗  core-app → ins-product-aggregator&#xa;   GET /products каждые 15 минут (синхронный REST-опрос)&#xa;   ЗАМЕНЕНО: подписка на Kafka-топик products.updated" style="text;html=1;align=left;fontSize=10;fillColor=#ffcccc;strokeColor=#cc0000;rounded=1;spacingLeft=5;" parent="1" vertex="1">
                    <mxGeometry x="240" y="1175" width="580" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="elim2" value="✗  ins-comp-settlement → ins-product-aggregator&#xa;   GET /products раз в сутки (синхронный REST-опрос)&#xa;   ЗАМЕНЕНО: подписка на Kafka-топик products.updated&#xa;&#xa;✗  ins-comp-settlement → core-app&#xa;   GET /policies раз в сутки (ночной батч, большой объём)&#xa;   ЗАМЕНЕНО: подписка на Kafka-топик policies.issued (real-time)" style="text;html=1;align=left;fontSize=10;fillColor=#ffcccc;strokeColor=#cc0000;rounded=1;spacingLeft=5;" parent="1" vertex="1">
                    <mxGeometry x="840" y="1175" width="680" height="110" as="geometry"/>
                </mxCell>
