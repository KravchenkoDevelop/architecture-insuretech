                </mxCell>
                <mxCell id="user1" value="Клиент&#xa;(браузер)" style="shape=mxgraph.archimate3.actor;fillColor=#5282FF;strokeColor=none;fontColor=white;fontSize=10;" parent="1" vertex="1">
