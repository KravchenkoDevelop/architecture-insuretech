    <diagram name="Event-Driven Architecture TO-BE" id="EDA-InsureTech-Task3">
        <mxGraphModel dx="1252" dy="1001" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1600" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="InsureTech — Контейнерная диаграмма TO-BE (Event-Driven Architecture)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="200" y="20" width="1800" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Взаимодействия, где данные меняются асинхронно, переведены на Event-Streaming через Kafka. Применён паттерн Transactional Outbox в core-app." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fillColor=none;strokeColor=none;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="200" y="55" width="1800" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="users_box" value="Пользователи (Клиенты InsureTech)" style="html=1;strokeColor=#999999;fillColor=#e3ebff;verticalAlign=top;fontSize=11;fontStyle=1;padding=8;" parent="1" vertex="1">
