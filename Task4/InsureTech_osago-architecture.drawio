                <!-- 12. topic_policies → settlement_svc (Kafka subscribe) -->
                <mxCell id="e_kafka_settlement_policies" value="subscribe PolicyIssued" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b71c1c;strokeWidth=2;fontSize=9;fontStyle=1;" parent="1" source="topic_policies" target="settlement_svc" edge="1">
