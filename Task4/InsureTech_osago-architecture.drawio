                <mxCell id="e_osago_ic" value="REST: POST /applications (параллельно)&#xa;REST: GET /applications/{id}/quote (polling)&#xa;[CB per СК] [Timeout: 60с] [Retry]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#cc6600;strokeWidth=2;fontSize=9;fontStyle=1;" parent="1" source="osago_svc" target="ic_box" edge="1">
