                </mxCell>

                <!-- ==================== API GATEWAY ==================== -->
                <mxCell id="api_gw" value="API Gateway / Nginx Ingress&#xa;&#xa;Маршрутизация HTTP REST-запросов&#xa;и SSE-соединений к core-app" style="rounded=1;fillColor=#5282FF;strokeColor=#3a60cc;fontColor=white;fontSize=10;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="340" y="275" width="240" height="80" as="geometry"/>
                </mxCell>

                <!-- Rate Limiting badge -->
                <mxCell id="badge_rl" value="Rate Limiting&#xa;(пик: 2 500 польз.)" style="rounded=1;fillColor=#FF8F00;strokeColor=#E65100;fontColor=white;fontSize=9;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="608" y="278" width="150" height="44" as="geometry"/>
                </mxCell>

                <!-- ==================== CORE-APP CONTAINER ==================== -->
                <mxCell id="core_app_box" value="core-app (контейнер)" style="html=1;strokeColor=#2e7d32;fillColor=#e8f5e9;verticalAlign=top;fontSize=11;fontStyle=1;padding=8;" parent="1" vertex="1">
                    <mxGeometry x="230" y="425" width="620" height="490" as="geometry"/>
                </mxCell>
                <mxCell id="core_app_svc" value="core-app&#xa;(Spring Boot / Node.js)&#xa;&#xa;• Оформление страховок&#xa;• Продукты, тарифы&#xa;• Приём заявок на ОСАГО&#xa;• POST → osago-aggregator&#xa;• Kafka consumer: osago.quotes&#xa;• Pub→ Redis Pub/Sub по app_id&#xa;• SSE-стрим предложений клиенту&#xa;• Outbox → PolicyIssued в Kafka" style="rounded=1;fillColor=#4caf50;strokeColor=#2e7d32;fontColor=white;fontSize=10;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="250" y="465" width="240" height="270" as="geometry"/>
                </mxCell>

                <!-- Redis Pub/Sub inside core-app -->
                <mxCell id="redis_pubsub" value="Redis Pub/Sub&#xa;&#xa;Канал: osago-quotes:{app_id}&#xa;&#xa;Фанаут quote-событий между&#xa;инстансами core-app:&#xa;любой pod получает из Kafka&#xa;→ публикует в Redis&#xa;→ pod с SSE-соединением&#xa;  отправляет клиенту" style="shape=cylinder3;fillColor=#ffccbc;strokeColor=#bf360c;fontSize=9;verticalAlign=bottom;align=center;" parent="1" vertex="1">
                    <mxGeometry x="510" y="460" width="310" height="180" as="geometry"/>
                </mxCell>

                <mxCell id="outbox_table" value="Outbox-таблица&#xa;(PostgreSQL)&#xa;&#xa;[Transactional Outbox]&#xa;policy_events: id, type,&#xa;payload, published_at&#xa;Запись атомарна с основной&#xa;транзакцией" style="shape=table;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=9;verticalAlign=top;align=left;spacingLeft=5;" parent="1" vertex="1">
                    <mxGeometry x="250" y="765" width="230" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="core_db" value="PostgreSQL&#xa;(core-app DB)&#xa;Страховки, клиенты,&#xa;реплика продуктов,&#xa;заявки ОСАГО" style="shape=cylinder3;fillColor=#a5d6a7;strokeColor=#2e7d32;fontSize=9;verticalAlign=bottom;" parent="1" vertex="1">
                    <mxGeometry x="505" y="760" width="160" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="outbox_relay" value="Outbox Relay&#xa;(CDC/Debezium)&#xa;&#xa;→ Kafka: policies.issued" style="rounded=1;fillColor=#81c784;strokeColor=#2e7d32;fontSize=9;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="690" y="660" width="140" height="80" as="geometry"/>
                </mxCell>

                <!-- Multi-instance note -->
                <mxCell id="multiinstance_note" value="⬡  Несколько инстансов core-app (K8s HPA): Redis Pub/Sub решает проблему SSE-фанаута — sticky sessions не нужны" style="text;html=1;align=left;fontSize=9;fillColor=#f1f8e9;strokeColor=#558b2f;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="230" y="893" width="610" height="35" as="geometry"/>
                </mxCell>

                <!-- ==================== KAFKA ==================== -->
                <mxCell id="kafka_box" value="Apache Kafka (Message Broker)" style="html=1;strokeColor=#b71c1c;fillColor=#ffebee;verticalAlign=top;fontSize=11;fontStyle=1;padding=8;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="890" y="380" width="1110" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="kafka_icon" value="Kafka" style="shape=mxgraph.logos.kafka;fillColor=#b71c1c;strokeColor=none;fontSize=10;fontColor=#b71c1c;verticalLabelPosition=bottom;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="910" y="398" width="50" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="topic_products" value="Топик: products.updated&#xa;&#xa;Событие: ProductUpdated&#xa;{ company_id, product_id,&#xa;  tariff, effective_from }&#xa;&#xa;Retention: 7 дней&#xa;Partitions: по company_id&#xa;&#xa;Producer: ins-product-aggregator&#xa;Consumers: core-app,&#xa;           ins-comp-settlement" style="rounded=1;fillColor=#ef9a9a;strokeColor=#b71c1c;fontSize=9;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="970" y="393" width="270" height="196" as="geometry"/>
                </mxCell>
                <mxCell id="topic_policies" value="Топик: policies.issued&#xa;&#xa;Событие: PolicyIssued&#xa;{ policy_id, client_id,&#xa;  product_id, company_id,&#xa;  amount, issued_at }&#xa;&#xa;Retention: 30 дней&#xa;Partitions: по date&#xa;&#xa;Producer: core-app (Outbox)&#xa;Consumer: ins-comp-settlement" style="rounded=1;fillColor=#ef9a9a;strokeColor=#b71c1c;fontSize=9;verticalAlign=top;align=left;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="1260" y="393" width="270" height="196" as="geometry"/>
                </mxCell>
                <!-- NEW Kafka topic -->
                <mxCell id="topic_osago" value="★ Топик: osago.quotes (NEW)&#xa;&#xa;Событие: OsagoQuoteReceived&#xa;{ application_id, company_id,&#xa;  premium, conditions,&#xa;  received_at, status }&#xa;&#xa;Retention: 1 час&#xa;Partitions: по application_id&#xa;&#xa;Producer: osago-aggregator&#xa;Consumer: core-app" style="rounded=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=9;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="1550" y="393" width="400" height="196" as="geometry"/>
                </mxCell>

                <!-- ==================== INS-PRODUCT-AGGREGATOR ==================== -->
                <mxCell id="agg_box" value="ins-product-aggregator (контейнер)" style="html=1;strokeColor=#1565c0;fillColor=#e3f2fd;verticalAlign=top;fontSize=11;fontStyle=1;padding=8;" parent="1" vertex="1">
                    <mxGeometry x="890" y="745" width="510" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="agg_svc" value="ins-product-aggregator&#xa;(фоновый сервис)&#xa;&#xa;• Периодически опрашивает&#xa;  каждую СК в фоне&#xa;• При изменении тарифов&#xa;  публикует ProductUpdated&#xa;• Circuit Breaker на каждую СК" style="rounded=1;fillColor=#1976d2;strokeColor=#1565c0;fontColor=white;fontSize=10;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="910" y="785" width="270" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="agg_cache" value="Redis / in-memory&#xa;&#xa;Снимок данных&#xa;по каждой СК" style="shape=cylinder3;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=9;verticalAlign=bottom;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="800" width="170" height="100" as="geometry"/>
                </mxCell>

                <!-- ==================== INS-COMP-SETTLEMENT ==================== -->
                <mxCell id="settlement_box" value="ins-comp-settlement (контейнер)" style="html=1;strokeColor=#6a1b9a;fillColor=#f3e5f5;verticalAlign=top;fontSize=11;fontStyle=1;padding=8;" parent="1" vertex="1">
                    <mxGeometry x="230" y="990" width="600" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="settlement_svc" value="ins-comp-settlement&#xa;(Spring Boot / сервис расчётов)&#xa;&#xa;• Подписан на products.updated&#xa;  — обновляет реплику продуктов&#xa;• Подписан на policies.issued&#xa;  — накапливает реестр полисов&#xa;• Нет ночного батч-запроса" style="rounded=1;fillColor=#8e24aa;strokeColor=#6a1b9a;fontColor=white;fontSize=10;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="250" y="1030" width="280" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="settlement_db" value="PostgreSQL&#xa;(settlement DB)&#xa;Реестр полисов,&#xa;реплика продуктов" style="shape=cylinder3;fillColor=#ce93d8;strokeColor=#6a1b9a;fontSize=9;verticalAlign=bottom;" parent="1" vertex="1">
                    <mxGeometry x="560" y="1060" width="150" height="100" as="geometry"/>
                </mxCell>

                <!-- ==================== OSAGO-AGGREGATOR (NEW) ==================== -->
                <mxCell id="osago_box" value="★ osago-aggregator (NEW, контейнер)" style="html=1;strokeColor=#00695C;fillColor=#E0F2F1;verticalAlign=top;fontSize=11;fontStyle=1;padding=8;strokeWidth=2;" parent="1" vertex="1">
                    <mxGeometry x="890" y="1080" width="680" height="490" as="geometry"/>
                </mxCell>
                <mxCell id="osago_svc" value="osago-aggregator&#xa;(Spring Boot / сервис)&#xa;&#xa;API для core-app:&#xa;  POST /osago/applications&#xa;  → { application_id } (быстро)&#xa;&#xa;Логика:&#xa;• Параллельно POST /applications&#xa;  в каждую СК&#xa;• Сохраняет IC-app-id[] в Redis&#xa;  (TTL 75 сек)&#xa;• Polling: GET /applications/{id}/quote&#xa;  каждую СК до ответа или таймаута&#xa;• Получил ответ → публикует&#xa;  OsagoQuoteReceived в Kafka&#xa;• После 60 с → публикует&#xa;  Timeout-событие для оставших СК" style="rounded=1;fillColor=#00897B;strokeColor=#00695C;fontColor=white;fontSize=10;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="910" y="1120" width="330" height="400" as="geometry"/>
                </mxCell>
                <mxCell id="osago_redis" value="Redis&#xa;(osago state store)&#xa;&#xa;In-flight заявки:&#xa;{ application_id,&#xa;  ic_app_ids: { СК→id },&#xa;  status_per_ic: map,&#xa;  created_at }&#xa;TTL: 75 сек&#xa;&#xa;Stateless scale-out:&#xa;хранилище обязательно&#xa;для multi-instance" style="shape=cylinder3;fillColor=#80CBC4;strokeColor=#00695C;fontSize=9;verticalAlign=bottom;align=center;" parent="1" vertex="1">
                    <mxGeometry x="1270" y="1120" width="260" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="osago_scale_note" value="⬡  Несколько инстансов osago-aggregator (K8s): состояние in-flight в Redis → инстансы stateless" style="text;html=1;align=left;fontSize=9;fillColor=#E0F2F1;strokeColor=#00695C;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="910" y="1538" width="640" height="32" as="geometry"/>
                </mxCell>

