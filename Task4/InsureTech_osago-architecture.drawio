                            <mxPoint x="760" y="380"/>
                            <mxPoint x="1395" y="380"/>
                        </Array>
                    </mxGeometry>
                </mxCell>

                <!-- 9. topic_products → core-app (Kafka subscribe) -->
                <mxCell id="e_kafka_core_products" value="subscribe ProductUpdated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b71c1c;strokeWidth=2;fontSize=9;fontStyle=1;" parent="1" source="topic_products" target="core_app_svc" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1105" y="350"/>
                            <mxPoint x="370" y="350"/>
                        </Array>
                    </mxGeometry>
                </mxCell>

                <!-- 10. agg_svc → topic_products (Kafka publish) -->
                <mxCell id="e_agg_kafka" value="publish ProductUpdated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b71c1c;strokeWidth=2;fontSize=9;fontStyle=1;" parent="1" source="agg_svc" target="topic_products" edge="1">
                    <mxGeometry relative="1" as="geometry">
