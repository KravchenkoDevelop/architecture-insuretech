                            <mxPoint x="1045" y="740"/>
                            <mxPoint x="1105" y="740"/>
                            <mxPoint x="1105" y="589"/>
                        </Array>
                    </mxGeometry>
                </mxCell>

                <!-- 11. topic_products → settlement_svc (Kafka subscribe) -->
                <mxCell id="e_kafka_settlement_products" value="subscribe ProductUpdated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b71c1c;strokeWidth=2;fontSize=9;fontStyle=1;" parent="1" source="topic_products" target="settlement_svc" edge="1">
                    <mxGeometry relative="1" as="geometry">
