                <mxCell id="e_core_redis_ps" value="publish to&#xa;channel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#bf360c;strokeWidth=1;fontSize=9;dashed=1;" parent="1" source="core_app_svc" target="redis_pubsub" edge="1">
