                    <mxGeometry x="1600" y="1374" width="200" height="30" as="geometry"/>
                </mxCell>

                <!-- Timeout badge on core-app → osago-aggregator REST -->
                <mxCell id="badge_timeout_core_osago" value="Timeout: 5 сек" style="rounded=1;fillColor=#37474F;strokeColor=#263238;fontColor=white;fontSize=9;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="740" y="1050" width="120" height="28" as="geometry"/>
                </mxCell>

                <!-- SSE label badge -->
                <mxCell id="badge_sse" value="SSE (Server-Sent Events)&#xa;новый тип интеграции" style="rounded=1;fillColor=#00695C;strokeColor=#004D40;fontColor=white;fontSize=9;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="165" y="240" width="190" height="40" as="geometry"/>
                </mxCell>

                <!-- ==================== EDGES ==================== -->

                <!-- 1. Users → API Gateway: REST -->
                <mxCell id="e_user_gw_rest" value="HTTPS / REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#5282FF;strokeWidth=2;fontSize=9;" parent="1" source="users_box" target="api_gw" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- 2. Users ↔ API Gateway: SSE (new, teal dashed) -->
                <mxCell id="e_user_gw_sse" value="SSE: GET /osago/{id}/quotes&#xa;(клиент открывает→сервер стримит)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#00897B;strokeWidth=2;fontSize=9;dashed=1;startArrow=block;startFill=0;endArrow=block;endFill=1;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="160" y="140"/>
                            <mxPoint x="160" y="315"/>
                            <mxPoint x="340" y="315"/>
                        </Array>
                        <mxPoint x="200" y="140" as="sourcePoint"/>
                        <mxPoint x="340" y="315" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>

                <!-- 3. API Gateway → core-app: REST -->
                <mxCell id="e_gw_core_rest" value="HTTP / REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#5282FF;strokeWidth=2;fontSize=9;" parent="1" source="api_gw" target="core_app_svc" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- 4. API Gateway → core-app: SSE relay (teal dashed) -->
                <mxCell id="e_gw_core_sse" value="SSE relay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#00897B;strokeWidth=2;fontSize=9;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0;entryDx=0;entryDy=0;" parent="1" source="api_gw" target="core_app_svc" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="220" y="315"/>
                            <mxPoint x="220" y="465"/>
                        </Array>
                    </mxGeometry>
                </mxCell>

                <!-- 5. core-app → core_db -->
                <mxCell id="e_core_db" value="SQL (JDBC)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2e7d32;fontSize=9;" parent="1" source="core_app_svc" target="core_db" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- 6. core-app → outbox_table (atomic write) -->
                <mxCell id="e_core_outbox" value="атомарная запись" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2e7d32;fontSize=9;dashed=1;" parent="1" source="core_app_svc" target="outbox_table" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- 7. outbox_relay reads outbox_table -->
                <mxCell id="e_relay_outbox" value="читает" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2e7d32;fontSize=9;" parent="1" source="outbox_relay" target="outbox_table" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="760" y="820"/>
                        </Array>
                    </mxGeometry>
                </mxCell>

                <!-- 8. outbox_relay → topic_policies (Kafka) -->
                <mxCell id="e_relay_kafka" value="publish PolicyIssued" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#b71c1c;strokeWidth=2;fontSize=9;fontStyle=1;" parent="1" source="outbox_relay" target="topic_policies" edge="1">
