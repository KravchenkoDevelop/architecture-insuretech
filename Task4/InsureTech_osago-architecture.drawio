                <mxCell id="ic_api_note" value="Единый REST API для всех СК (оба агрегатора):&#xa;POST /applications — создать заявку&#xa;GET /applications/{id}/quote — получить предложение по ОСАГО&#xa;GET /products, GET /tariffs — тарифы и продукты (ins-product-aggregator)" style="text;html=1;align=left;fontSize=9;fillColor=#fff3e0;strokeColor=#cc6600;spacingLeft=5;" parent="1" vertex="1">
                    <mxGeometry x="2100" y="548" width="510" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="ic_note_products" value="ins-product-aggregator → СК&#xa;(фоновый опрос тарифов, [CB] per СК)" style="text;html=1;align=center;fontSize=9;fillColor=#e3f2fd;strokeColor=#1565c0;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="2100" y="640" width="510" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="ic_note_osago" value="osago-aggregator → СК&#xa;(ОСАГО заявки, [CB]+[Timeout: 60с]+[Retry] per СК)" style="text;html=1;align=center;fontSize=9;fillColor=#E0F2F1;strokeColor=#00695C;fontStyle=2;" parent="1" vertex="1">
                    <mxGeometry x="2100" y="700" width="510" height="40" as="geometry"/>
                </mxCell>

