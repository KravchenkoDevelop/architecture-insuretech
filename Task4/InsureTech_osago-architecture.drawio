                <mxCell id="badge_cb_agg" value="Circuit Breaker (per СК)" style="rounded=1;fillColor=#C62828;strokeColor=#7f0000;fontColor=white;fontSize=9;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1600" y="850" width="180" height="30" as="geometry"/>
