                <mxCell id="e_settlement_db" value="SQL (JDBC)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#6a1b9a;fontSize=9;" parent="1" source="settlement_svc" target="settlement_db" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- 14. agg_svc → IC box (products polling, orange) -->
                <mxCell id="e_agg_ic" value="REST: GET тарифы/продукты&#xa;(фоновый, [CB] per СК)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#cc6600;strokeWidth=2;fontSize=9;fontStyle=1;" parent="1" source="agg_svc" target="ic_box" edge="1">
