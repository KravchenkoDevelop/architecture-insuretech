                <!-- 15. core-app → osago-aggregator (REST, NEW) -->
                <mxCell id="e_core_osago_rest" value="REST POST /osago/applications&#xa;→ {application_id}  [Timeout: 5с]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#00897B;strokeWidth=2;fontSize=9;fontStyle=1;" parent="1" source="core_app_svc" target="osago_svc" edge="1">
