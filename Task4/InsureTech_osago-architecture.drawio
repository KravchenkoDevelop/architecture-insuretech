                <mxCell id="elim1" value="✗  core-app → ins-product-aggregator: GET /products каждые 15 мин&#xa;   ЗАМЕНЕНО: подписка на Kafka-топик products.updated" style="text;html=1;align=left;fontSize=10;fillColor=#ffcccc;strokeColor=#cc0000;rounded=1;spacingLeft=5;" parent="1" vertex="1">
