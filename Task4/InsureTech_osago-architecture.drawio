                    <mxGeometry x="1600" y="1290" width="180" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="badge_timeout_osago" value="Timeout: 60 сек (per СК)" style="rounded=1;fillColor=#37474F;strokeColor=#263238;fontColor=white;fontSize=9;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1600" y="1332" width="180" height="30" as="geometry"/>
